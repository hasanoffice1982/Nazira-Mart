# ---- local development ----
DEBUG=True
SECRET_KEY=change-me

# ---- production: set DEBUG=False and everything below ----
# DEBUG=False
# SECRET_KEY=<long random string>            # required when DEBUG is False
# ALLOWED_HOSTS=narizmart.com,www.narizmart.com   # required when DEBUG is False
# CSRF_TRUSTED_ORIGINS=https://narizmart.com,https://www.narizmart.com
# DATABASE_URL=postgres://user:pass@localhost:5432/narizmart
# REDIS_URL=redis://localhost:6379/1         # shared cache so rate limits hold across workers
# DEFAULT_FROM_EMAIL=NarizMart <no-reply@narizmart.com>
# RESEND_API_KEY=re_xxxxxxxxxxxx             # Resend: this one value configures SMTP (smtp.resend.com:587, user "resend")
# (other SMTP provider instead: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS)
# USE_X_FORWARDED_FOR=True                   # default when DEBUG is False; only behind a trusted proxy
# SECURE_SSL_REDIRECT=True                   # default when DEBUG is False; set False on plain-http staging

# ADMIN_URL=manage-k7x2p9/              # move the admin off /admin/ (letters, digits . _ ~ - and /)
# SITE_URL=https://example.com           # absolute links in emails
# SUPPORT_EMAIL=hello@example.com        # contact-form messages go here
# MEDIA_ROOT=/srv/narizmart/shared/media
# STATIC_ROOT=/srv/narizmart/shared/static
# APP_VERSION=dev                        # set by the deploy; versions the service worker
# WEB_CONCURRENCY=3                      # gunicorn workers
