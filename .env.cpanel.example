# Copy to .env on the server (same folder as manage.py) and fill in. Never commit .env.
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=narizmart.com,www.narizmart.com
CSRF_TRUSTED_ORIGINS=https://narizmart.com,https://www.narizmart.com
SITE_URL=https://narizmart.com
DATABASE_URL=mysql://salespal_DBUSER:DBPASSWORD@localhost:3306/salespal_narizmart
STATIC_ROOT=/home/salespal/narizmart_data/static
MEDIA_ROOT=/home/salespal/narizmart_data/media
ADMIN_URL=manage-k7x2p9/
SUPPORT_EMAIL=hello@narizmart.com
DEFAULT_FROM_EMAIL=NarizMart <no-reply@narizmart.com>
SECURE_SSL_REDIRECT=True

# --- supplier (Smart DropShop BD) API: keys from My Stores > Nariz Mart > API Settings. Never commit real values. ---
# SUPPLIER_API_KEY=key_live_...
# SUPPLIER_API_SECRET=sec_live_...
# SUPPLIER_WEBHOOK_TOKEN=a-long-random-string        # becomes part of the webhook URL, see SUPPLIER.md
# SUPPLIER_AUTO_SEND=True                            # send orders when staff mark them Confirmed
